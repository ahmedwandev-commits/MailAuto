# Copy this file to ".env" and fill in your values.  Never share the .env file.
#
# The values below match the built-in MOCK system, so the demo works as-is.
# For the real system put your real user code and password.

PORTAL_USERNAME=233786
PORTAL_PASSWORD=Mock@12345

# CEM login (leave empty to reuse the portal values)
CEM_USERNAME=233786
CEM_PASSWORD=Mock@12345

# Employee code tickets are re-assigned to (step "إعادة اسناد"); default = PORTAL_USERNAME
OPERATOR_ID=233786
